# SAIL MARINEX Environment Configuration
# Project: SAIL MARINEX - Intelligent Maritime Freight & Charter Intelligence
# Problem Statement: SIH 26006 (Ministry of Steel / Steel Authority of India Limited)

# Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="SAIL MARINEX"
API_V1_PREFIX="/api/v1"

# Database (PostgreSQL 16+ with PostGIS, pgcrypto, pg_trgm, btree_gist)
DATABASE_URL="postgresql+asyncpg://sail_marinex:marinex_secure_pass@localhost:5432/sail_marinex_db"
DATABASE_URL_SYNC="postgresql+psycopg2://sail_marinex:marinex_secure_pass@localhost:5432/sail_marinex_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis Cache & Message Broker
REDIS_URL="redis://:redis_secure_pass@localhost:6379/0"

# Authentication & Security
JWT_SECRET="sail_marinex_super_secure_jwt_secret_key_change_in_prod_2026_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME="argon2"

# Security Limits & Policies
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=120

# Object Storage (S3 / MinIO for Maritime Documents & Model Artifacts)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="sail-marinex-documents"
S3_REGION="ap-south-1"

# SMTP / Email Alerts
SMTP_HOST="smtp.sail.in"
SMTP_PORT=587
SMTP_USER="notifications@marinex.sail.in"
SMTP_PASSWORD="change_me_smtp_password"
SMTP_FROM_EMAIL="marinex-alerts@sail.in"
SMTP_FROM_NAME="SAIL MARINEX Decision Intelligence"

# System Encryption (AES-256 for data source credentials)
DATA_ENCRYPTION_KEY="marinex_32byte_secret_key_for_db_encryption_!!"

# Live External Data Ingestion Feeds (Official Sources)
# AISStream.io — Real-Time Maritime AIS Vessel Stream (Free tier registration at aisstream.io)
AISSTREAM_API_KEY=""

# U.S. EIA API v2 — Coal Spot Prices & Bunker Benchmarks (Free registration at eia.gov)
EIA_API_KEY=""

# St. Louis Fed FRED — International Freight & Mineral Commodities (Free registration at stlouisfed.org)
FRED_API_KEY=""

# Open-Meteo Marine Weather API (100% Free Public API — No API Key Required)
OPEN_METEO_BASE_URL="https://marine-api.open-meteo.com/v1/marine"

# European Central Bank via Frankfurter API (100% Free Public API — No API Key Required)
FRANKFURTER_API_BASE="https://api.frankfurter.app"


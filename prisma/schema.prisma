// ============================================================================
// SAIL MARINEX - PRISMA ORM SCHEMA (POSTGRESQL 16+)
// Ministry of Steel / Steel Authority of India Limited (SAIL)
// Problem Statement: SIH 26006
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, postgis, pg_trgm, btree_gist]
}

// ----------------------------------------------------------------------------
// 1. ORGANIZATIONS & TENANCY
// ----------------------------------------------------------------------------

model Organization {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationCode     String                 @unique @map("organization_code") @db.VarChar(50)
  legalName            String                 @map("legal_name") @db.VarChar(255)
  displayName          String                 @map("display_name") @db.VarChar(150)
  organizationType     String                 @default("ENTERPRISE") @map("organization_type") @db.VarChar(50)
  industry             String                 @default("Steel & Maritime Logistics") @db.VarChar(100)
  countryId            String?                @map("country_id") @db.Uuid
  defaultCurrencyId    String?                @map("default_currency_id") @db.Uuid
  timezone             String                 @default("Asia/Kolkata") @db.VarChar(50)
  status               String                 @default("ACTIVE") @db.VarChar(30)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?                @map("created_by") @db.Uuid
  updatedBy            String?                @map("updated_by") @db.Uuid
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz(6)

  users                User[]
  settings             OrganizationSetting[]
  departments          Department[]
  userRoles            UserRole[]
  cargoParcels         CargoParcel[]
  contracts            Contract[]
  voyages              Voyage[]
  procurementRequests  ProcurementRequirement[]
  recommendations      Recommendation[]
  alerts               Alert[]
  approvalWorkflows    ApprovalWorkflow[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  settingKey     String       @map("setting_key") @db.VarChar(100)
  settingValue   Json         @map("setting_value")
  description    String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, settingKey])
  @@map("organization_settings")
}

model Department {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  departmentCode String       @map("department_code") @db.VarChar(50)
  departmentName String       @map("department_name") @db.VarChar(150)
  status         String       @default("ACTIVE") @db.VarChar(30)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, departmentCode])
  @@map("departments")
}

// ----------------------------------------------------------------------------
// 2. USERS & AUTHENTICATION
// ----------------------------------------------------------------------------

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  employeeCode     String            @map("employee_code") @db.VarChar(50)
  firstName        String            @map("first_name") @db.VarChar(100)
  middleName       String?           @map("middle_name") @db.VarChar(100)
  lastName         String            @map("last_name") @db.VarChar(100)
  displayName      String            @map("display_name") @db.VarChar(150)
  email            String            @unique @db.VarChar(255)
  phone            String?           @db.VarChar(50)
  status           String            @default("ACTIVE") @db.VarChar(30)
  timezone         String            @default("Asia/Kolkata") @db.VarChar(50)
  locale           String            @default("en-IN") @db.VarChar(20)
  lastLoginAt      DateTime?         @map("last_login_at") @db.Timestamptz(6)
  emailVerifiedAt  DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials      UserCredential?
  sessions         UserSession[]
  userRoles        UserRole[]
  notifications    Notification[]

  @@unique([organizationId, employeeCode])
  @@map("users")
}

model UserCredential {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  passwordSalt         String?   @map("password_salt") @db.VarChar(100)
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockoutUntil         DateTime? @map("lockout_until") @db.Timestamptz(6)
  isMfaEnabled         Boolean   @default(false) @map("is_mfa_enabled")
  mfaSecret            String?   @map("mfa_secret") @db.VarChar(255)
  passwordHistory      Json?     @map("password_history")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserSession {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  sessionTokenHash   String         @unique @map("session_token_hash") @db.VarChar(255)
  ipAddress          String?        @map("ip_address") @db.VarChar(50)
  userAgent          String?        @map("user_agent") @db.Text
  deviceFingerprint  String?        @map("device_fingerprint") @db.VarChar(255)
  isActive           Boolean        @default(true) @map("is_active")
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(6)
  lastActivityAt     DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?        @map("revoked_reason") @db.VarChar(100)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]

  @@map("user_sessions")
}

model RefreshToken {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String      @map("session_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  tokenHash         String      @unique @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(6)
  isRevoked         Boolean     @default(false) @map("is_revoked")
  replacedByTokenId String?     @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session           UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// 3. RBAC (EXACTLY 6 SYSTEM ROLES)
// ----------------------------------------------------------------------------

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleName        String           @unique @map("role_name") @db.VarChar(50)
  displayName     String           @map("display_name") @db.VarChar(100)
  description     String?          @db.Text
  isSystemRole    Boolean          @default(true) @map("is_system_role")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissionCode String           @unique @map("permission_code") @db.VarChar(100)
  domain         String           @db.VarChar(50)
  action         String           @db.VarChar(50)
  description    String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// ----------------------------------------------------------------------------
// 4. GEOGRAPHY & UNITS MASTER
// ----------------------------------------------------------------------------

model Continent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique @db.VarChar(10)
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  countries Country[]

  @@map("continents")
}

model Country {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iso2              String     @unique @db.VarChar(2)
  iso3              String     @unique @db.VarChar(3)
  name              String     @unique @db.VarChar(150)
  continentId       String?    @map("continent_id") @db.Uuid
  unCode            String?    @map("un_code") @db.VarChar(10)
  isMaritimeNation  Boolean    @default(true) @map("is_maritime_nation")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  continent         Continent? @relation(fields: [continentId], references: [id])
  ports             Port[]

  @@map("countries")
}

model Currency {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique @db.VarChar(3)
  name          String         @db.VarChar(100)
  symbol        String         @db.VarChar(10)
  decimalPlaces Int            @default(2) @map("decimal_places")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  freightRates  FreightRate[]
  freightCodes  FreightCode[]
  contracts     Contract[]

  @@map("currencies")
}

model UnitCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryName String   @unique @map("category_name") @db.VarChar(50)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  units        Unit[]

  @@map("unit_categories")
}

model Unit {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  unitCode     String        @unique @map("unit_code") @db.VarChar(30)
  unitName     String        @map("unit_name") @db.VarChar(100)
  symbol       String        @db.VarChar(20)
  isStandardSi Boolean       @default(false) @map("is_standard_si")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     UnitCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  freightRates FreightRate[]
  freightCodes FreightCode[]
  contracts    Contract[]

  @@map("units")
}

// ----------------------------------------------------------------------------
// 5. PORTS & INFRASTRUCTURE
// ----------------------------------------------------------------------------

model Port {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portName         String           @map("port_name") @db.VarChar(150)
  officialName     String           @map("official_name") @db.VarChar(200)
  unLocode         String           @unique @map("un_locode") @db.VarChar(5)
  countryId        String           @map("country_id") @db.Uuid
  state            String?          @db.VarChar(100)
  city             String?          @db.VarChar(100)
  latitude         Decimal          @db.Decimal(9, 6)
  longitude        Decimal          @db.Decimal(9, 6)
  timezone         String           @default("Asia/Kolkata") @db.VarChar(50)
  portType         String           @default("MAJOR_SEA_PORT") @map("port_type") @db.VarChar(50)
  isEastCoastIndia Boolean          @default(false) @map("is_east_coast_india")
  status           String           @default("OPERATIONAL") @db.VarChar(30)
  isSynthetic      Boolean          @default(false) @map("is_synthetic")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country          Country          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  terminals        PortTerminal[]
  constraints      PortConstraint[]
  originRoutes     Route[]          @relation("OriginPortRoutes")
  destRoutes       Route[]          @relation("DestPortRoutes")
  originParcels    CargoParcel[]    @relation("OriginParcels")
  destParcels      CargoParcel[]    @relation("DestParcels")
  originProcure    ProcurementRequirement[] @relation("DestProcurements")

  @@map("ports")
}

model PortTerminal {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portId       String           @map("port_id") @db.Uuid
  terminalCode String           @map("terminal_code") @db.VarChar(50)
  terminalName String           @map("terminal_name") @db.VarChar(150)
  terminalType String           @map("terminal_type") @db.VarChar(50)
  operator     String?          @db.VarChar(150)
  status       String           @default("OPERATIONAL") @db.VarChar(30)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port         Port             @relation(fields: [portId], references: [id], onDelete: Cascade)
  berths       PortBerth[]
  constraints  PortConstraint[]

  @@unique([portId, terminalCode])
  @@map("port_terminals")
}

model PortBerth {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  terminalId   String           @map("terminal_id") @db.Uuid
  berthCode    String           @map("berth_code") @db.VarChar(50)
  berthName    String           @map("berth_name") @db.VarChar(150)
  berthLengthM Decimal          @map("berth_length_m") @db.Decimal(8, 2)
  designDraftM Decimal          @map("design_draft_m") @db.Decimal(6, 2)
  maxDwtMt     Decimal          @map("max_dwt_mt") @db.Decimal(12, 2)
  status       String           @default("OPERATIONAL") @db.VarChar(30)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  terminal     PortTerminal     @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  constraints  PortConstraint[]

  @@unique([terminalId, berthCode])
  @@map("port_berths")
}

model PortConstraint {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portId         String        @map("port_id") @db.Uuid
  terminalId     String?       @map("terminal_id") @db.Uuid
  berthId        String?       @map("berth_id") @db.Uuid
  constraintName String        @map("constraint_name") @db.VarChar(150)
  constraintType String        @map("constraint_type") @db.VarChar(50)
  maxLoaM        Decimal?      @map("max_loa_m") @db.Decimal(8, 2)
  minLoaM        Decimal?      @map("min_loa_m") @db.Decimal(8, 2)
  maxBeamM       Decimal?      @map("max_beam_m") @db.Decimal(8, 2)
  maxDraftM      Decimal?      @map("max_draft_m") @db.Decimal(6, 2)
  minDraftM      Decimal?      @map("min_draft_m") @db.Decimal(6, 2)
  channelDraftM  Decimal?      @map("channel_draft_m") @db.Decimal(6, 2)
  berthDraftM    Decimal?      @map("berth_draft_m") @db.Decimal(6, 2)
  maxAirDraftM   Decimal?      @map("max_air_draft_m") @db.Decimal(6, 2)
  maxDwtMt       Decimal?      @map("max_dwt_mt") @db.Decimal(12, 2)
  maxGtMt        Decimal?      @map("max_gt_mt") @db.Decimal(12, 2)
  validFrom      DateTime      @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime?     @map("valid_to") @db.Timestamptz(6)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  port           Port          @relation(fields: [portId], references: [id], onDelete: Cascade)
  terminal       PortTerminal? @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  berth          PortBerth?    @relation(fields: [berthId], references: [id], onDelete: Cascade)

  @@map("port_constraints")
}

// ----------------------------------------------------------------------------
// 6. VESSELS & CLASSES
// ----------------------------------------------------------------------------

model VesselClass {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classCode     String        @unique @map("class_code") @db.VarChar(30)
  className     String        @map("class_name") @db.VarChar(100)
  minDwtMt      Decimal       @map("min_dwt_mt") @db.Decimal(12, 2)
  maxDwtMt      Decimal       @map("max_dwt_mt") @db.Decimal(12, 2)
  typicalBeamM  Decimal?      @map("typical_beam_m") @db.Decimal(6, 2)
  typicalLoaM   Decimal?      @map("typical_loa_m") @db.Decimal(8, 2)
  description   String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vessels       Vessel[]
  freightCodes  FreightCode[]

  @@map("vessel_classes")
}

model Vessel {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imoNumber        String        @unique @map("imo_number") @db.VarChar(10)
  mmsi             String?       @unique @db.VarChar(15)
  callSign         String?       @map("call_sign") @db.VarChar(20)
  vesselName       String        @map("vessel_name") @db.VarChar(150)
  vesselClassId    String        @map("vessel_class_id") @db.Uuid
  vesselType       String        @default("DRY_BULK_CARRIER") @map("vessel_type") @db.VarChar(50)
  buildYear        Int           @map("build_year")
  dwtMt            Decimal       @map("dwt_mt") @db.Decimal(12, 2)
  grossTonnage     Decimal       @map("gross_tonnage") @db.Decimal(12, 2)
  netTonnage       Decimal       @map("net_tonnage") @db.Decimal(12, 2)
  loaM             Decimal       @map("loa_m") @db.Decimal(8, 2)
  beamM            Decimal       @map("beam_m") @db.Decimal(6, 2)
  summerDraftM     Decimal       @map("summer_draft_m") @db.Decimal(6, 2)
  grainCapacityCbm Decimal?      @map("grain_capacity_cbm") @db.Decimal(12, 2)
  designSpeedKnots Decimal       @default(13.5) @map("design_speed_knots") @db.Decimal(5, 2)
  status           String        @default("ACTIVE") @db.VarChar(30)
  isSynthetic      Boolean       @default(false) @map("is_synthetic")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vesselClass      VesselClass   @relation(fields: [vesselClassId], references: [id], onDelete: Restrict)
  voyages          Voyage[]

  @@map("vessels")
}

// ----------------------------------------------------------------------------
// 7. CARGO MASTER & PARCELS
// ----------------------------------------------------------------------------

model CargoCategory {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryCode String      @unique @map("category_code") @db.VarChar(50)
  categoryName String      @map("category_name") @db.VarChar(100)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cargoTypes   CargoType[]

  @@map("cargo_categories")
}

model CargoType {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId         String          @map("category_id") @db.Uuid
  cargoCode          String          @unique @map("cargo_code") @db.VarChar(50)
  cargoName          String          @map("cargo_name") @db.VarChar(100)
  stowageFactorCbmMt Decimal?        @map("stowage_factor_cbm_mt") @db.Decimal(6, 3)
  isHazardous        Boolean         @default(false) @map("is_hazardous")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           CargoCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  freightCodes       FreightCode[]
  parcels            CargoParcel[]
  procurements       ProcurementRequirement[]

  @@map("cargo_types")
}

model CargoParcel {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  parcelCode         String       @unique @map("parcel_code") @db.VarChar(100)
  cargoTypeId        String       @map("cargo_type_id") @db.Uuid
  quantityMt         Decimal      @map("quantity_mt") @db.Decimal(14, 2)
  originPortId       String       @map("origin_port_id") @db.Uuid
  destinationPortId  String       @map("destination_port_id") @db.Uuid
  laycanStart        DateTime     @map("laycan_start") @db.Timestamptz(6)
  laycanEnd          DateTime     @map("laycan_end") @db.Timestamptz(6)
  priority           String       @default("MEDIUM") @db.VarChar(30)
  status             String       @default("PLANNED") @db.VarChar(30)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cargoType          CargoType    @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)
  originPort         Port         @relation("OriginParcels", fields: [originPortId], references: [id])
  destPort           Port         @relation("DestParcels", fields: [destinationPortId], references: [id])
  voyages            Voyage[]

  @@map("cargo_parcels")
}

// ----------------------------------------------------------------------------
// 8. FREIGHT MASTER & STRUCTURED FREIGHT CODES
// ----------------------------------------------------------------------------

model FreightType {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeCode     String        @unique @map("type_code") @db.VarChar(50)
  typeName     String        @map("type_name") @db.VarChar(100)
  description  String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  freightCodes FreightCode[]

  @@map("freight_types")
}

model FreightRateType {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateTypeCode String        @unique @map("rate_type_code") @db.VarChar(50)
  rateTypeName String        @map("rate_type_name") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  freightCodes FreightCode[]

  @@map("freight_rate_types")
}

model FreightCode {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String          @unique @db.VarChar(100)
  vesselClassId String          @map("vessel_class_id") @db.Uuid
  cargoTypeId   String          @map("cargo_type_id") @db.Uuid
  freightTypeId String          @map("freight_type_id") @db.Uuid
  rateTypeId    String          @map("rate_type_id") @db.Uuid
  currencyId    String          @map("currency_id") @db.Uuid
  unitId        String          @map("unit_id") @db.Uuid
  description   String?         @db.Text
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vesselClass   VesselClass     @relation(fields: [vesselClassId], references: [id], onDelete: Restrict)
  cargoType     CargoType       @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)
  freightType   FreightType     @relation(fields: [freightTypeId], references: [id], onDelete: Restrict)
  rateType      FreightRateType @relation(fields: [rateTypeId], references: [id], onDelete: Restrict)
  currency      Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unit          Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  rates         FreightRate[]
  forecastRuns  ForecastRun[]
  contracts     Contract[]

  @@map("freight_codes")
}

model FreightRate {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freightCodeId   String       @map("freight_code_id") @db.Uuid
  rate            Decimal      @db.Decimal(16, 4)
  currencyId      String       @map("currency_id") @db.Uuid
  unitId          String       @map("unit_id") @db.Uuid
  observationDate DateTime     @map("observation_date") @db.Timestamptz(6)
  effectiveFrom   DateTime     @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime?    @map("effective_to") @db.Timestamptz(6)
  source          String       @default("BALTIC_EXCHANGE") @db.VarChar(100)
  confidence      Decimal      @default(1.0) @db.Decimal(5, 4)
  isSynthetic     Boolean      @default(false) @map("is_synthetic")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  freightCode     FreightCode  @relation(fields: [freightCodeId], references: [id], onDelete: Cascade)
  currency        Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@map("freight_rates")
}

// ----------------------------------------------------------------------------
// 9. TRADE LANES & ROUTES
// ----------------------------------------------------------------------------

model TradeLane {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  laneCode          String   @unique @map("lane_code") @db.VarChar(50)
  laneName          String   @map("lane_name") @db.VarChar(150)
  originRegion      String   @map("origin_region") @db.VarChar(100)
  destinationRegion String   @default("East Coast India") @map("destination_region") @db.VarChar(100)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  routes            Route[]

  @@map("trade_lanes")
}

model Route {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeLaneId          String    @map("trade_lane_id") @db.Uuid
  routeCode            String    @unique @map("route_code") @db.VarChar(100)
  originPortId         String    @map("origin_port_id") @db.Uuid
  destinationPortId    String    @map("destination_port_id") @db.Uuid
  distanceNm           Decimal   @map("distance_nm") @db.Decimal(10, 2)
  estimatedSailingDays Decimal   @map("estimated_sailing_days") @db.Decimal(6, 2)
  hasCanalTransit      Boolean   @default(false) @map("has_canal_transit")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tradeLane            TradeLane @relation(fields: [tradeLaneId], references: [id], onDelete: Restrict)
  originPort           Port      @relation("OriginPortRoutes", fields: [originPortId], references: [id])
  destinationPort      Port      @relation("DestPortRoutes", fields: [destinationPortId], references: [id])
  voyages              Voyage[]

  @@map("routes")
}

// ----------------------------------------------------------------------------
// 10. VOYAGES, CONTRACTS & ECONOMICS
// ----------------------------------------------------------------------------

model Contract {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  contractNumber         String       @unique @map("contract_number") @db.VarChar(100)
  contractType           String       @map("contract_type") @db.VarChar(50)
  supplierChartererName  String       @map("supplier_charterer_name") @db.VarChar(200)
  freightCodeId          String?      @map("freight_code_id") @db.Uuid
  agreedRate             Decimal      @map("agreed_rate") @db.Decimal(16, 4)
  currencyId             String       @map("currency_id") @db.Uuid
  unitId                 String       @map("unit_id") @db.Uuid
  effectiveFrom          DateTime     @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime     @map("effective_to") @db.Timestamptz(6)
  status                 String       @default("DRAFT") @db.VarChar(30)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  freightCode            FreightCode? @relation(fields: [freightCodeId], references: [id])
  currency               Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unit                   Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  voyages                Voyage[]

  @@map("contracts")
}

model Voyage {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  voyageNumber     String           @unique @map("voyage_number") @db.VarChar(100)
  vesselId         String           @map("vessel_id") @db.Uuid
  contractId       String?          @map("contract_id") @db.Uuid
  cargoParcelId    String?          @map("cargo_parcel_id") @db.Uuid
  routeId          String           @map("route_id") @db.Uuid
  plannedDeparture DateTime         @map("planned_departure") @db.Timestamptz(6)
  actualDeparture  DateTime?        @map("actual_departure") @db.Timestamptz(6)
  plannedArrival   DateTime         @map("planned_arrival") @db.Timestamptz(6)
  actualArrival    DateTime?        @map("actual_arrival") @db.Timestamptz(6)
  status           String           @default("PLANNED") @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vessel           Vessel           @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  contract         Contract?        @relation(fields: [contractId], references: [id])
  cargoParcel      CargoParcel?     @relation(fields: [cargoParcelId], references: [id])
  route            Route            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  economics        VoyageEconomics?

  @@map("voyages")
}

model VoyageEconomics {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voyageId              String   @unique @map("voyage_id") @db.Uuid
  freightRevenueUsd     Decimal  @default(0) @map("freight_revenue_usd") @db.Decimal(16, 2)
  bunkerCostUsd         Decimal  @default(0) @map("bunker_cost_usd") @db.Decimal(16, 2)
  portDisbursementUsd   Decimal  @default(0) @map("port_disbursement_usd") @db.Decimal(16, 2)
  canalDuesUsd          Decimal  @default(0) @map("canal_dues_usd") @db.Decimal(16, 2)
  idleTimeCostUsd       Decimal  @default(0) @map("idle_time_cost_usd") @db.Decimal(16, 2)
  demurrageUsd          Decimal  @default(0) @map("demurrage_usd") @db.Decimal(16, 2)
  totalCostUsd          Decimal  @map("total_cost_usd") @db.Decimal(16, 2)
  netProfitOrSavingsUsd Decimal  @map("net_profit_or_savings_usd") @db.Decimal(16, 2)
  tceUsdPerDay          Decimal  @map("tce_usd_per_day") @db.Decimal(14, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  voyage                Voyage   @relation(fields: [voyageId], references: [id], onDelete: Cascade)

  @@map("voyage_economics")
}

// ----------------------------------------------------------------------------
// 11. PROCUREMENT & DECISION INTELLIGENCE
// ----------------------------------------------------------------------------

model ProcurementRequirement {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  requirementCode    String       @unique @map("requirement_code") @db.VarChar(100)
  cargoTypeId        String       @map("cargo_type_id") @db.Uuid
  requiredVolumeMt   Decimal      @map("required_volume_mt") @db.Decimal(14, 2)
  destinationPortId  String       @map("destination_port_id") @db.Uuid
  deliveryWindowStart DateTime    @map("delivery_window_start") @db.Timestamptz(6)
  deliveryWindowEnd   DateTime    @map("delivery_window_end") @db.Timestamptz(6)
  status             String       @default("OPEN") @db.VarChar(30)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cargoType          CargoType    @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)
  destinationPort    Port         @relation("DestProcurements", fields: [destinationPortId], references: [id])

  @@map("procurement_requirements")
}

model ForecastRun {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freightCodeId String              @map("freight_code_id") @db.Uuid
  runTimestamp DateTime             @default(now()) @map("run_timestamp") @db.Timestamptz(6)
  horizonDays  Int                  @map("horizon_days")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  freightCode  FreightCode          @relation(fields: [freightCodeId], references: [id], onDelete: Cascade)
  predictions  ForecastPrediction[]

  @@map("forecast_runs")
}

model ForecastPrediction {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  forecastRunId String      @map("forecast_run_id") @db.Uuid
  forecastDate  DateTime    @map("forecast_date") @db.Timestamptz(6)
  predictedRate Decimal     @map("predicted_rate") @db.Decimal(16, 4)
  lowerBound    Decimal     @map("lower_bound") @db.Decimal(16, 4)
  upperBound    Decimal     @map("upper_bound") @db.Decimal(16, 4)
  confidence    Decimal     @db.Decimal(5, 4)
  trend         String      @default("STABLE") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  forecastRun   ForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)

  @@map("forecast_predictions")
}

model Recommendation {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  recommendationType       String       @map("recommendation_type") @db.VarChar(50)
  subjectEntityType        String       @map("subject_entity_type") @db.VarChar(50)
  subjectEntityId          String       @map("subject_entity_id") @db.Uuid
  decision                 String       @db.VarChar(100)
  confidence               Decimal      @db.Decimal(5, 4)
  riskLevel                String       @default("MEDIUM") @map("risk_level") @db.VarChar(30)
  expectedFinancialImpactUsd Decimal?   @map("expected_financial_impact_usd") @db.Decimal(16, 2)
  isActive                 Boolean      @default(true) @map("is_active")
  validUntil               DateTime     @map("valid_until") @db.Timestamptz(6)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("recommendations")
}

// ----------------------------------------------------------------------------
// 12. ALERTS, NOTIFICATIONS & AUDIT LOGS
// ----------------------------------------------------------------------------

model Alert {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  title          String         @db.VarChar(200)
  message        String         @db.Text
  severity       String         @default("MEDIUM") @db.VarChar(30)
  status         String         @default("OPEN") @db.VarChar(30)
  triggeredAt    DateTime       @default(now()) @map("triggered_at") @db.Timestamptz(6)
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@map("alerts")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  alertId   String?   @map("alert_id") @db.Uuid
  channel   String    @default("IN_APP") @db.VarChar(30)
  title     String    @db.VarChar(200)
  body      String    @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert     Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String   @map("entity_id") @db.Uuid
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model ApprovalWorkflow {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workflowType   String       @map("workflow_type") @db.VarChar(50)
  subjectId      String       @map("subject_id") @db.Uuid
  status         String       @default("PENDING") @db.VarChar(30)
  requestedBy    String       @map("requested_by") @db.Uuid
  approvedBy     String?      @map("approved_by") @db.Uuid
  comments       String?      @db.Text
  actionTakenAt  DateTime?    @map("action_taken_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("approval_workflows")
}
